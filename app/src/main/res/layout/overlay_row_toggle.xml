<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="30dp"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingStart="2dp" android:paddingEnd="2dp">
    <TextView android:id="@+id/label"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:textColor="#DDE3EC" android:textSize="10sp" />
    <Switch android:id="@+id/switchToggle"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:scaleX="0.7" android:scaleY="0.7"
        android:thumbTint="@color/switch_thumb" android:trackTint="@color/switch_track" />
</LinearLayout>
